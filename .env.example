# 复制一份改名 .env 后按需修改：cp .env.example .env
# 不建 .env 也能跑，compose 里所有变量都写了开发默认值（${VAR:-默认值}）。
# 真正部署到公网之前，下面标了「必须改」的一定要换掉。
#
# 注意：注释必须独占一行。写成 VAR=value # 注释 在非空值时能剥离，
# 但 VAR= # 注释 会把注释当成值本身（已实测踩坑）。

# ---------------------------------------------------------------------------
# 宿主机映射端口
# 只改左边（宿主机端口），右边容器端口固定不要动。
#
# 硬性约束：宿主机端口必须 > 15000（或 < 1024）。
# 本机 IPv4 动态端口范围是 1024-15000（netsh int ipv4 show dynamicport tcp），
# Hyper-V 会从这个区间里随机划走连续段，落在里面的端口随时可能绑定失败
# （13306 就中过招，被 13208-13307 段吃掉）。80 因 < 1024 而安全。
# 查看当前被划走的段：netsh interface ipv4 show excludedportrange protocol=tcp
# ---------------------------------------------------------------------------
FRONTEND_PORT=80
BACKEND_PORT=18080
MYSQL_PORT=33306
REDIS_PORT=16379
RABBITMQ_PORT=56720
RABBITMQ_MGMT_PORT=15672

# ---------------------------------------------------------------------------
# MySQL
# 后端同时用 MYSQL_ROOT_PASSWORD 作为 SPRING_DATASOURCE_PASSWORD 和 DB_PASSWORD
# 必须改：换成你自己的密码
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=blog_dev_pwd
MYSQL_USER=root

# ---------------------------------------------------------------------------
# Redis（默认无密码；启用 --requirepass 后同步设这里）
# ---------------------------------------------------------------------------
# REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# RabbitMQ（管理台 http://localhost:15672）
# 必须改：换成你自己的账号密码
# ---------------------------------------------------------------------------
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ---------------------------------------------------------------------------
# 后端 JWT
# HS512 要求密钥长度至少 64 字节。
# 生成：node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# 必须填写；留空时 Docker Compose 会拒绝启动。
# ---------------------------------------------------------------------------
JWT_SECRET=

# ---------------------------------------------------------------------------
# 前端
# 构建期变量，会被 Vite 内联进产物，改完必须重建镜像：
#   docker compose build --no-cache frontend && docker compose up -d frontend
# 默认 /api 表示与页面同源，由容器内 Nginx 反代到后端，没有跨域问题。
# 只有前后端不同域时才需要改成完整地址，例如 https://api.example.com/api
# ---------------------------------------------------------------------------
VITE_API_BASE=/api

# ---------------------------------------------------------------------------
# 后端 JVM 参数
# ---------------------------------------------------------------------------
# JAVA_OPTS=-Xms512m -Xmx768m
